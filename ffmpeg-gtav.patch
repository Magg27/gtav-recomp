+    shared = tcos_cache_get(nbits, s->mdct_permutation, key_scale, s->tcos);
+    if (shared && shared != s->tcos) { /* another thread published the same table first */
+        const ptrdiff_t tsin_offset = s->tsin - s->tcos;
