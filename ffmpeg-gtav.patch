     scale = sqrt(fabs(scale));
     for(i=0;i<n4;i++) {
@@ -101,6 +156,13 @@ av_cold int ff_mdct_init(FFTContext *s, int nbits, int inverse, double scale)
         s->tsin[i*tstep] = FIX15(-sin(alpha) * scale);
