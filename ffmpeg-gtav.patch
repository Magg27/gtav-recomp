+/* gtav: an FFT's bit-reversal table depends only on its size, direction and permutation, and
+ * computing it is a large part of what opening a WMA Pro / XMA decoder costs (GTA V opens a
+ * fresh decoder for every sound it starts: a third of a phone core went into these tables).
+ * Each kind is computed once, shared by every context and never freed. */
+static AVMutex revtab_cache_mutex = AV_MUTEX_INITIALIZER;
+static void *revtab_cache[18][2][3]; /* [nbits][inverse][permutation] */
+
+static void **revtab_cache_slot(const FFTContext *s)
+{
+    if (s->nbits < 2 || s->nbits > 17 || (s->inverse != 0 && s->inverse != 1) ||
+        (int)s->fft_permutation < 0 || (int)s->fft_permutation > 2)
+        return NULL;
+    return &revtab_cache[s->nbits][s->inverse][s->fft_permutation];
+}
+
+static int revtab_is_cached(const void *table)
+{
+    int found = 0;
+    if (!table)
+        return 0;
+    ff_mutex_lock(&revtab_cache_mutex);
+    for (int a = 0; a < 18 && !found; a++)
+        for (int b = 0; b < 2 && !found; b++)
+            for (int c = 0; c < 3; c++)
+                if (revtab_cache[a][b][c] == table) {
+                    found = 1;
+                    break;
+                }
+    ff_mutex_unlock(&revtab_cache_mutex);
+    return found;
+}
+
+/* The context's freshly allocated table gives way to the shared one, or becomes it. */
+static void revtab_cache_use(FFTContext *s, void **slot, int publish)
+{
+    ff_mutex_lock(&revtab_cache_mutex);
+    if (*slot) {
+        if (s->revtab) {
+            av_free(s->revtab);
+            s->revtab = *slot;
+        } else {
+            av_free(s->revtab32);
+            s->revtab32 = *slot;
+        }
+    } else if (publish) {
+        *slot = s->revtab ? (void *)s->revtab : (void *)s->revtab32;
+    }
+    ff_mutex_unlock(&revtab_cache_mutex);
+}
+
 av_cold int ff_fft_init(FFTContext *s, int nbits, int inverse)
 {
     int i, j, n;
+    void **cache_slot;
 
     s->revtab = NULL;
     s->revtab32 = NULL;
@@ -262,6 +313,14 @@ av_cold int ff_fft_init(FFTContext *s, int nbits, int inverse)
 #endif /* FFT_FIXED_32 */
 
 
+    cache_slot = revtab_cache_slot(s);
+    if (cache_slot) {
+        const void *fresh = s->revtab ? (void *)s->revtab : (void *)s->revtab32;
+        revtab_cache_use(s, cache_slot, 0);
+        if (fresh != (s->revtab ? (void *)s->revtab : (void *)s->revtab32))
+            return 0; /* the shared table */
+    }
+
     if (ARCH_X86 && FFT_FLOAT && s->fft_permutation == FF_FFT_PERM_AVX) {
         fft_perm_avx(s);
     } else {
@@ -302,6 +361,8 @@ av_cold int ff_fft_init(FFTContext *s, int nbits, int inverse)
 #undef SPLIT_RADIX_PERMUTATION
     }
 
+    if (cache_slot)
+        revtab_cache_use(s, cache_slot, 1);
     return 0;
  fail:
     av_freep(&s->revtab);
@@ -327,6 +388,10 @@ static void fft_permute_c(FFTContext *s, FFTComplex *z)
 
