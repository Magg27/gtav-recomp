+/* gtav: the MDCT's cos/sin table depends only on its size, scale and layout; see the note at
+ * ff_fft_init. Computed once per kind, shared, never freed. A full cache just stops caching. */
+static AVMutex tcos_cache_mutex = AV_MUTEX_INITIALIZER;
+static struct {
+    int nbits, permutation;
+    double scale;
+    FFTSample *tcos;
+} tcos_cache[64];
+static int tcos_cache_count;
+
+/* The shared table for the key; with `fresh`, publishes it when there is none yet. */
+static FFTSample *tcos_cache_get(int nbits, int permutation, double scale, FFTSample *fresh)
+{
+    FFTSample *found = NULL;
+    ff_mutex_lock(&tcos_cache_mutex);
+    for (int i = 0; i < tcos_cache_count; i++)
+        if (tcos_cache[i].nbits == nbits && tcos_cache[i].permutation == permutation &&
+            tcos_cache[i].scale == scale) {
+            found = tcos_cache[i].tcos;
+            break;
+        }
+    if (!found && fresh && tcos_cache_count < FF_ARRAY_ELEMS(tcos_cache)) {
+        tcos_cache[tcos_cache_count].nbits       = nbits;
+        tcos_cache[tcos_cache_count].permutation = permutation;
+        tcos_cache[tcos_cache_count].scale       = scale;
+        tcos_cache[tcos_cache_count].tcos        = fresh;
+        tcos_cache_count++;
+        found = fresh;
+    }
+    ff_mutex_unlock(&tcos_cache_mutex);
+    return found;
+}
+
+static int tcos_is_cached(const FFTSample *tcos)
+{
+    int found = 0;
+    if (!tcos)
+        return 0;
+    ff_mutex_lock(&tcos_cache_mutex);
+    for (int i = 0; i < tcos_cache_count; i++)
+        if (tcos_cache[i].tcos == tcos) {
+            found = 1;
+            break;
+        }
+    ff_mutex_unlock(&tcos_cache_mutex);
+    return found;
+}
